# Automaton Auditor — Environment Variables
# Copy this file to .env and fill in your actual keys.
# NEVER commit .env to version control.

# ─── LLM API Keys (priority: Groq → Google → OpenAI) ────────────────────────
# Groq — FREE, generous quota (14,400 req/day, resets per minute) — RECOMMENDED
# Get key at: https://console.groq.com → API Keys → Create API Key
GROQ_API_KEY=your_groq_api_key_here

# Google Gemini (gemini-2.0-flash)
GOOGLE_API_KEY=your_google_api_key_here

# OpenAI GPT-4o-mini (fallback)
OPENAI_API_KEY=your_openai_api_key_here

# ─── LangSmith Observability ─────────────────────────────────────────────────
# Enable full trace visibility for the multi-agent swarm
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=automaton-auditor

# ─── Optional: GitHub Token (for private repos) ───────────────────────────────
# GITHUB_TOKEN=your_github_token_here
