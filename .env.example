# Automaton Auditor — Environment Variables
# Copy this file to .env and fill in your actual keys.
# NEVER commit .env to version control.

# ─── LLM Providers ─────────────────────────────────────────────────────────
# Priority:
# 1) Ollama (LOCAL, FREE, no quotas) if OLLAMA_MODEL is set
# 2) Groq (FREE tier) → Google Gemini → OpenAI

# Ollama (LOCAL)
# Install: https://ollama.com/
# Pull a model: `ollama pull llama3.1:8b`
# Then set:
OLLAMA_MODEL=
OLLAMA_BASE_URL=http://localhost:11434

# Groq — FREE tier
# Get key at: https://console.groq.com → API Keys → Create API Key
GROQ_API_KEY=your_groq_api_key_here

# Google Gemini (gemini-2.0-flash)
GOOGLE_API_KEY=your_google_api_key_here

# OpenAI GPT-4o-mini (fallback)
OPENAI_API_KEY=your_openai_api_key_here

# ─── LangSmith Observability ─────────────────────────────────────────────────
# Enable full trace visibility for the multi-agent swarm
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=automaton-auditor

# ─── Optional: GitHub Token (for private repos) ───────────────────────────────
# GITHUB_TOKEN=your_github_token_here
