# Automaton Auditor — Environment Variables
# Copy this file to .env and fill in your actual keys.
# NEVER commit .env to version control.

# ─── LLM API Keys (at least one required) ────────────────────────────────────
# Google Gemini (preferred — used for RepoInvestigator, DocAnalyst, Judges)
GOOGLE_API_KEY=your_google_api_key_here

# OpenAI GPT-4o (fallback if Google key not set)
OPENAI_API_KEY=your_openai_api_key_here

# ─── LangSmith Observability ─────────────────────────────────────────────────
# Enable full trace visibility for the multi-agent swarm
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=automaton-auditor

# ─── Optional: GitHub Token (for private repos) ───────────────────────────────
# GITHUB_TOKEN=your_github_token_here
